
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles            UserRole[]
  ownedProfile     TalentProfile?  @relation("ProfileOwner")
  guardianProfiles TalentProfile[] @relation("PrimaryGuardian")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model TalentProfile {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String
  dateOfBirth DateTime?
  heightCm    Int?
  gender      String?
  location    String?
  bio         String?

  ownerUserId           String? @unique @db.Uuid
  primaryGuardianUserId String? @db.Uuid

  ownerUser User? @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  primaryGuardian User? @relation("PrimaryGuardian", fields: [primaryGuardianUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

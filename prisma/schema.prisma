generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TalentProfileStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TalentLinkType {
  PREVIOUS_WORK
  PORTFOLIO
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                  UserRole[]
  ownedProfile           TalentProfile?          @relation("ProfileOwner")
  guardianProfiles       TalentProfile[]         @relation("PrimaryGuardian")
  sessions               Session[]
  emailVerificationToken EmailVerificationToken?
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model TalentProfile {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String
  dateOfBirth DateTime?
  heightCm    Int?
  gender      String?
  location    String?
  bio         String?
  status      TalentProfileStatus @default(ACTIVE)

  languages         String[] @default([])
  experienceYears   Int?
  experienceSummary String?  @db.VarChar(2000)
  instagramHandle   String?  @db.VarChar(31)
  introVideoUrl     String?  @db.VarChar(2048)

  ownerUserId           String? @unique @db.Uuid
  primaryGuardianUserId String? @db.Uuid

  ownerUser User? @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  primaryGuardian User? @relation("PrimaryGuardian", fields: [primaryGuardianUserId], references: [id], onDelete: Restrict)

  links  TalentProfileLink[]
  photos TalentProfilePhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TalentProfileLink {
  id              String         @id @default(uuid()) @db.Uuid
  talentProfileId String         @db.Uuid
  type            TalentLinkType
  title           String         @db.VarChar(120)
  url             String         @db.VarChar(2048)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@index([talentProfileId, type, sortOrder])
}

model TalentProfilePhoto {
  id              String   @id @default(uuid()) @db.Uuid
  talentProfileId String   @db.Uuid
  url             String   @db.VarChar(2048)
  fileId          String?  @unique @db.VarChar(64)
  filePath        String?  @db.VarChar(2048)
  altText         String?  @db.VarChar(200)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)

  @@index([talentProfileId, sortOrder])
}

model EmailVerificationToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId    String @unique @db.Uuid

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId    String @db.Uuid

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

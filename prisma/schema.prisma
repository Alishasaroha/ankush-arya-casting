generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                  UserRole[]
  ownedProfile           TalentProfile?          @relation("ProfileOwner")
  guardianProfiles       TalentProfile[]         @relation("PrimaryGuardian")
  sessions               Session[]
  emailVerificationToken EmailVerificationToken?
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model TalentProfile {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String
  dateOfBirth DateTime?
  heightCm    Int?
  gender      String?
  location    String?
  bio         String?

  ownerUserId           String? @unique @db.Uuid
  primaryGuardianUserId String? @db.Uuid

  ownerUser User? @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  primaryGuardian User? @relation("PrimaryGuardian", fields: [primaryGuardianUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId    String @unique @db.Uuid

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId    String @db.Uuid

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
